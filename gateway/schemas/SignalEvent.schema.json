{
  "$defs": {
    "BotIdentity": {
      "description": "Identity of the producer.",
      "properties": {
        "bot_id": {
          "minLength": 1,
          "title": "Bot Id",
          "type": "string"
        },
        "bot_role": {
          "minLength": 1,
          "title": "Bot Role",
          "type": "string"
        },
        "bot_version": {
          "minLength": 1,
          "title": "Bot Version",
          "type": "string"
        }
      },
      "required": [
        "bot_id",
        "bot_role",
        "bot_version"
      ],
      "title": "BotIdentity",
      "type": "object"
    },
    "TraceContext": {
      "properties": {
        "decision_id": {
          "description": "Stable id for a decision (UUID recommended)",
          "minLength": 8,
          "title": "Decision Id",
          "type": "string"
        },
        "trace_id": {
          "description": "End-to-end trace id (UUID recommended)",
          "minLength": 8,
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "trace_id"
      ],
      "title": "TraceContext",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "timestamp_utc": {
      "format": "date-time",
      "title": "Timestamp Utc",
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/BotIdentity"
    },
    "trace": {
      "$ref": "#/$defs/TraceContext"
    },
    "event_type": {
      "const": "SignalEvent",
      "default": "SignalEvent",
      "enum": [
        "SignalEvent"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "symbol": {
      "minLength": 3,
      "title": "Symbol",
      "type": "string"
    },
    "market": {
      "default": "futures",
      "title": "Market",
      "type": "string"
    },
    "timeframe": {
      "default": "1m",
      "title": "Timeframe",
      "type": "string"
    },
    "side": {
      "enum": [
        "LONG",
        "SHORT"
      ],
      "title": "Side",
      "type": "string"
    },
    "decision": {
      "default": "DO_NOT_TRADE",
      "enum": [
        "DO_NOT_TRADE",
        "TRADE_SELECTIVELY",
        "TRADE"
      ],
      "title": "Decision",
      "type": "string"
    },
    "probability_calibrated": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Probability Calibrated",
      "type": "number"
    },
    "confidence_bucket": {
      "default": "UNKNOWN",
      "title": "Confidence Bucket",
      "type": "string"
    },
    "regime": {
      "default": "UNKNOWN",
      "title": "Regime",
      "type": "string"
    },
    "veto_passed": {
      "default": false,
      "title": "Veto Passed",
      "type": "boolean"
    },
    "veto_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Veto Reasons",
      "type": "array"
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "feature_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Feature Version"
    },
    "risk_params": {
      "title": "Risk Params",
      "type": "object"
    }
  },
  "required": [
    "identity",
    "trace",
    "symbol",
    "side"
  ],
  "title": "SignalEvent",
  "type": "object"
}