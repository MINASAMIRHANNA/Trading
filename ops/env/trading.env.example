# Shared (non-secret) environment for the Trading monorepo
TRADING_ROOT=/home/mina/projects/Trading
TRADING_VENV=/home/mina/projects/Trading/.venv

# Ports
BRAIN_PORT=8100
GATEWAY_PORT=8200
MINA_PAPER_PORT=8000
MINA_LIVE_PORT=8001
MINA_PUMP_PORT=8002

# Upstreams (used by Gateway)
BRAIN_URL=http://127.0.0.1:8100
MINA_PAPER_URL=http://127.0.0.1:8000
MINA_LIVE_URL=http://127.0.0.1:8001
MINA_PUMP_URL=http://127.0.0.1:8002

# Logs & data (optional)
TRADING_LOG_DIR=/home/mina/projects/Trading/logs

# Unified Postgres (optional at first; safe migration path)
# If set, Mina_Bot will mirror shared data (settings/logs/events) into Postgres.
# Keep this disabled until you finish creating the DB + schema.
TRADING_PG_DSN=postgresql://mina:CHANGE_ME@127.0.0.1:5432/trading
